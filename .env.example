# Copy to .env.local and fill in your own values.

# RapidAPI key for ExerciseDB demo GIFs.
# Get one (free): https://rapidapi.com/justin-WFnsXH_t6/api/exercisedb
VITE_EXERCISEDB_KEY=your_rapidapi_key_here

# Web Push — public VAPID key (generate a pair with `npx web-push generate-vapid-keys`).
# The private key goes in server/.env, never here.
VITE_VAPID_PUBLIC_KEY=your_vapid_public_key
# URL of the push server. Only needed when it's on a DIFFERENT origin than the
# app (e.g. local dev: Vite on :5180, server on :8787). On a single-origin VPS
# deploy (the server serves the app too), leave this EMPTY / omit it.
VITE_PUSH_SERVER=http://localhost:8787
